[Unit]
Description=anheyu-app NestJS backend
After=network.target

[Service]
Type=simple
User=node
Group=node
WorkingDirectory=/opt/anheyu/server
ExecStart=/usr/bin/node /opt/anheyu/server/dist/main
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=8091
Environment=DB_PATH=/opt/anheyu/server/data/blog.db
# JWT_SECRET 仅为通过 Joi 校验，运行时不读取；真实密钥在后台面板设置（见 DEPLOYMENT.md §8）
Environment=JWT_SECRET=joi-placeholder
Environment=JWT_EXPIRES_IN=15m
Environment=JWT_REFRESH_EXPIRES_IN=30d
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
